#!/bin/bash

# [description]
#
#   Installs 'gha-tools' and puts it at /usr/local/bin so no PATH modification is required.
#

set -e -u -o pipefail

# parse command-line flags
aws_cli_flag=0
gh_cli_flag=0
gha_tools_flag=0
rustup_flag=0
sccache_flag=0
yq_flag=0
uv_flag=0

while [[ $# -gt 0 ]]; do
  case $1 in
    --aws-cli)
      aws_cli_flag=1
      shift
      ;;
    --gh-cli)
      gh_cli_flag=1
      shift
      ;;
    --gha-tools)
      gha_tools_flag=1
      shift
      ;;
    --rustup)
      rustup_flag=1
      shift
      ;;
    --sccache)
      sccache_flag=1
      shift
      ;;
    --uv)
      uv_flag=1
      shift
      ;;
    --yq)
      yq_flag=1
      shift
      ;;
    -*)
      echo "Unknown flag: $1" >&2
      exit 1
      ;;
  esac
done

TOOL_INSTALL_DIR="${TOOL_INSTALL_DIR:-/usr/local/bin}"
download_dir="$(mktemp -d)"
trap 'rm -rf -- "$download_dir"' EXIT

# avoid leaking apt-get install'd packages out of this script
PACKAGES_TO_INSTALL=()
if ! type -f unzip >/dev/null 2>&1; then
  PACKAGES_TO_INSTALL+=(unzip)
fi
if ! type -f wget >/dev/null 2>&1; then
  PACKAGES_TO_INSTALL+=(wget)
fi

if [[ "${#PACKAGES_TO_INSTALL[@]}" != "0" ]]; then
  echo "could not find some necessary packages, temporarily installing them"
  if type -f apt-get >/dev/null 2>&1; then
      i=0
      until apt-get update -y; do
        ((++i >= 5)) && break;
        sleep 10;
      done
      apt-get install -y --no-install-recommends \
        "${PACKAGES_TO_INSTALL[@]}"
  else
      dnf update -y
      dnf install --nodocs -y \
        "${PACKAGES_TO_INSTALL[@]}"
  fi
fi

# install gha-tools first, as other things below depend on it
if (( gha_tools_flag == 1 )); then
  echo "installing 'gha-tools'"
  if [[ -n "${GHA_TOOLS_CANDIDATE_REVISION:-}" ]]; then
    if [[ ! "${GHA_TOOLS_CANDIDATE_REVISION}" =~ ^[0-9a-f]{40}$ ]]; then
      echo 'Invalid candidate gha-tools revision' >&2
      exit 1
    fi
    candidate_tools="$(dirname "${BASH_SOURCE[0]}")/candidate-gha-tools"
    if [[ "$(cat "${candidate_tools}/revision.txt")" != "${GHA_TOOLS_CANDIDATE_REVISION}" ]]; then
      echo 'Candidate gha-tools archive has the wrong revision' >&2
      exit 1
    fi
    candidate_checksum=$(cat "${candidate_tools}/sha256.txt")
    if [[ ! "${candidate_checksum}" =~ ^[0-9a-f]{64}$ ]]; then
      echo 'Invalid candidate gha-tools archive checksum' >&2
      exit 1
    fi
    printf '%s  %s\n' "${candidate_checksum}" "${candidate_tools}/tools.tar.gz" |
      sha256sum --check --status
    # git archive carries a tools/ prefix; release archives below are flat.
    tar -xzf "${candidate_tools}/tools.tar.gz" --strip-components=1 -C "${TOOL_INSTALL_DIR}"
  else
  : "${GHA_TOOLS_VERSION:?GHA_TOOLS_VERSION must be set}"
  : "${GHA_TOOLS_SHA256:?GHA_TOOLS_SHA256 must be set}"
  gha_tools_archive="${download_dir}/tools.tar.gz"
  wget -q --tries=4 --retry-on-http-error=429,500,502,503,504 --waitretry=10 \
    "https://github.com/rapidsai/gha-tools/releases/download/v${GHA_TOOLS_VERSION}/tools.tar.gz" \
    -O "${gha_tools_archive}"
  echo "${GHA_TOOLS_SHA256}  ${gha_tools_archive}" | sha256sum --check --status
  tar -xzf "${gha_tools_archive}" -C "${TOOL_INSTALL_DIR}"
  rm -f "${gha_tools_archive}"
  fi
  echo "done installing 'gha-tools' to '${TOOL_INSTALL_DIR}'"
fi

# Keep uv outside Python environments so activating a venv or conda env preserves it.
if (( uv_flag == 1 )); then
  uv_installer=$(mktemp)
  rapids-retry wget -q "https://astral.sh/uv/${UV_VER}/install.sh" -O "${uv_installer}"
  UV_UNMANAGED_INSTALL="${TOOL_INSTALL_DIR}" sh "${uv_installer}"
  rm -f "${uv_installer}"
  uv --version
fi

# install gh CLI
# NOTE: gh CLI must be installed before rapids-install-sccache (uses `gh release download`)
if (( gh_cli_flag == 1 )); then
  echo "installing 'gh' CLI"
  rapids-retry wget -q --tries=1 "https://github.com/cli/cli/releases/download/v${GH_CLI_VER}/gh_${GH_CLI_VER}_linux_${CPU_ARCH}.tar.gz" \
    -O "${download_dir}/gh.tar.gz"
  tar -xf "${download_dir}/gh.tar.gz" -C "${download_dir}"
  mv "${download_dir}"/gh_*/bin/gh "${TOOL_INSTALL_DIR}"
  echo "done installing 'gh' CLI to '${TOOL_INSTALL_DIR}'"
fi

# install AWS CLI
if (( aws_cli_flag == 1 )); then
  echo "installing AWS CLI"
  # ref: https://docs.aws.amazon.com/cli/latest/userguide/getting-started-install.html#getting-started-install-instructions
  rapids-retry wget --tries=1 -O "${download_dir}/awscliv2.zip" \
    "https://awscli.amazonaws.com/awscli-exe-linux-${REAL_ARCH}-${AWS_CLI_VER}.zip"
  unzip -q "${download_dir}/awscliv2.zip" -d "${download_dir}"
  "${download_dir}/aws/install"
fi

# install rustup
if (( rustup_flag == 1 )); then
  echo "installing rustup"
  rapids-retry wget -O /tmp/rustup-init https://sh.rustup.rs/
  RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo sh /tmp/rustup-init --yes --no-update-default-toolchain
  rm /tmp/rustup-init
  echo "done installing 'rustup' CLI to '${TOOL_INSTALL_DIR}'"
fi

# install sccache
if (( sccache_flag == 1 )); then
  echo "installing 'sccache'"
  SCCACHE_VERSION="${SCCACHE_VER}" rapids-install-sccache
  echo "done installing 'sccache'"
fi

# install yq
if (( yq_flag == 1 )); then
  echo "installing 'yq'"
  rapids-retry wget -q --tries=1 https://github.com/mikefarah/yq/releases/download/v${YQ_VER}/yq_linux_${CPU_ARCH} -O "${download_dir}/yq"
  mv "${download_dir}/yq" "${TOOL_INSTALL_DIR}"
  chmod +x "${TOOL_INSTALL_DIR}/yq"
fi

# possibly uninstall system packages needed for the installs above
if [[ "${#PACKAGES_TO_INSTALL[@]}" != "0" ]]; then
    if type -f apt-get >/dev/null 2>&1; then
        apt-get purge -y \
          "${PACKAGES_TO_INSTALL[@]}"
        apt-get autoremove -y
        rm -rf \
          /var/cache/apt/archives \
          /var/lib/apt/lists/*
    else
        dnf remove -y \
          "${PACKAGES_TO_INSTALL[@]}"
        dnf clean all
    fi
    # either way, clean up docs and other unnecessary stuff
    rm -rf \
      /usr/share/doc \
      /usr/share/info \
      /usr/share/man
fi
