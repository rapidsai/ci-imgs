set -euo pipefail

# Never execute a partial installer or retry diagnostics from a download pipe.
installer="$(mktemp)"
trap 'rm -f -- "$installer"' EXIT
rapids-retry curl -fsSL --output "$installer" https://pyenv.run
bash "$installer"
